{
  "name": "@dsh-external/dsh-client-ui-skin-deep-orca-day-night",
  "description": "Original aurora day and deep-sea night skin for the DeepSeek Harness Web GUI.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./skin.json": "./skin.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/build.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-theme": ">=0.1.0-rc.5 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-theme": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "files": [
    "package.json",
    "cordis.patch.yml",
    "skin.json",
    "lib/index.js",
    "lib/client.js",
    "scripts/build.mjs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ]
}
